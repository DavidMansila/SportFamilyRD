# Esta plantilla viene con los valores SEGUROS por defecto, no con los de
# desarrollo: es de aqui de donde se copia la configuracion a Render, y un
# APP_DEBUG=true que se cuele en produccion hace que cualquier error muestre
# el stack trace completo (rutas del servidor, variables de entorno, el
# password de la BD y la APP_KEY) a cualquier visitante.
#
# PARA TRABAJAR EN LOCAL, cambia estas en tu .env despues de copiarla:
#   APP_ENV=local
#   APP_DEBUG=true
#   LOG_LEVEL=debug
#   SESSION_SECURE_COOKIE=false
APP_NAME=SportFamilyRD
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
# APP_URL TIENE QUE SER EL HOST REAL POR EL QUE SE SIRVE LA APP
# (protocolo, dominio y puerto incluidos).
#
# No es cosmetico: los enlaces de verificacion de correo van FIRMADOS, y la
# firma se calcula sobre la URL completa. Si APP_URL no coincide con el host por
# el que entra la gente, todos los enlaces de verificacion se rechazan con 403 y
# NADIE puede activar su cuenta.
#
# En Render: https://tu-app.onrender.com
# En local con Apache en el 8080: http://localhost:8080
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Local MySQL/SQLite (alternative to Supabase, e.g. offline development)
# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Supabase Postgres via the Supavisor connection pooler (IPv4-compatible).
# Get these values from the Supabase dashboard: Project Settings > Database > Connection pooling.
# Do NOT use the direct "db.<ref>.supabase.co" host locally — it is IPv6-only
# and will fail to resolve on most local/ISP networks.
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# true en produccion (Render sirve por HTTPS): impide que la cookie de sesion
# viaje por HTTP plano.
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Para que el chat funcione en tiempo real hay que cambiarlo a "pusher".
# Con "log" los eventos solo se escriben en storage/logs y no llegan al navegador.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Disco "public" (avatares, fotos de posts/productos/eventos). En local se
# deja en "local" (storage:link). En un host con filesystem efimero (Render
# free borra todo lo que no este en el repo cada vez que el contenedor
# duerme/reinicia) hay que ponerlo en "s3" y llenar las variables AWS_* de
# mas abajo con las credenciales S3 de Supabase Storage
# (Project Settings > Storage > S3 Connection).
PUBLIC_DISK_DRIVER=local
# URL publica de los archivos subidos (imagenes de posts, avatares...).
# Con el disco local dejala relativa: si sale de APP_URL, las imagenes quedan
# atadas al host y puerto de esa variable, y basta con servir la app en otro
# puerto para que TODAS den connection-refused (mismo criterio que el baseURL
# de axios en resources/js/bootstrap.js). Si los archivos se mueven a
# S3/Supabase Storage, aqui va la URL absoluta del bucket.
PUBLIC_DISK_URL=/storage
# PUBLIC_DISK_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>

# Dominios que pueden llamar a la API (CORS), separados por coma. Tiene que
# ser la lista explicita del dominio real (p. ej. https://sportfamilyrd.onrender.com).
#
# Vacio = mismo origen unicamente, que es lo correcto aqui: Laravel sirve el
# SPA y la API desde el mismo host, asi que el navegador ni siquiera hace una
# peticion cross-origin en uso normal. "*" NO es un valor valido en esta
# aplicacion: config/cors.php manda credenciales (supports_credentials), y la
# especificacion CORS prohibe combinar credenciales con comodin.
CORS_ALLOWED_ORIGINS=

# Token secreto para /api/internal/schedule-run. Render free no trae cron
# propio: un cron externo gratuito (cron-job.org) llama esa ruta cada minuto
# con ?token=<este valor> para disparar news:import/calendar:import/etc.
# Vacio en local desactiva la ruta.
CRON_SECRET=

# Pusher - WebSockets del chat y los mensajes.
# Credenciales en https://dashboard.pusher.com > Channels > App Keys.
# Las de servidor (ID y SECRET) son privadas y no deben salir del backend.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Estas dos las compila Vite dentro del JavaScript, asi que acaban siendo
# visibles en el navegador: usa aqui solo la clave publica, nunca el secret.
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# 'database' guardaria el cache en la misma base de datos remota (Supabase) que
# se esta intentando evitar: cada lectura de cache costaria un viaje de red y el
# cache no ahorraria casi nada. 'file' lo deja en storage/framework/cache.
# En produccion, con varios servidores, lo correcto seria redis.
CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Credenciales S3 de Supabase Storage (usadas solo si PUBLIC_DISK_DRIVER=s3).
#
# EN RENDER ESTO NO ES OPCIONAL: el sistema de archivos del contenedor es
# efimero. Con PUBLIC_DISK_DRIVER=local, las fotos de perfil y las imagenes que
# suba la gente desaparecen en cada reinicio.
#
# Las dos claves se generan en Supabase: Project Settings > Storage >
# S3 Connection. El SECRET solo se muestra una vez, al crearlo.
#
# El resto de valores ya corresponden al proyecto (bucket 'sportfamilyrd',
# publico, region us-east-2). Copia el "Endpoint" exacto que muestre esa
# pantalla: el subdominio varia entre <ref>.supabase.co y
# <ref>.storage.supabase.co segun el proyecto.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
AWS_BUCKET=sportfamilyrd
AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

# ORDEN DE MIGRACION A SUPABASE STORAGE (importa):
#   1. rellenar las dos claves de arriba
#   2. php artisan storage:subir-supabase --dry-run
#   3. php artisan storage:subir-supabase
#   4. recien entonces cambiar las dos lineas de PUBLIC_DISK_* de mas arriba a:
#        PUBLIC_DISK_DRIVER=s3
#        PUBLIC_DISK_URL=https://<project-ref>.supabase.co/storage/v1/object/public/sportfamilyrd
#
# Si se cambia el disco ANTES de subir, la aplicacion apunta a un bucket sin
# los archivos y todas las imagenes salen rotas mientras dura la subida.

VITE_APP_NAME="${APP_NAME}"

# Supabase Realtime (llave publica/anon, segura para exponer en el navegador)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Content-Security-Policy en modo bloqueo. Dejar en false hasta haber
# recorrido el SPA completo sin violaciones reportadas en la consola.
CSP_ENFORCE=false
